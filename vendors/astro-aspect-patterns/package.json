{
  "name": "astro-aspect-patterns",
  "version": "0.0.1",
  "description": "Framework-agnostic generator of geometric patterns driven by astrological aspects",
  "keywords": [
    "astrology",
    "astro",
    "aspects",
    "geometry",
    "pattern",
    "svg",
    "canvas",
    "generative"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterns/aspect-field": {
      "types": "./dist/patterns/aspectField.d.ts",
      "import": "./dist/patterns/aspectField.js",
      "require": "./dist/patterns/aspectField.cjs"
    },
    "./patterns/star-polygon": {
      "types": "./dist/patterns/starPolygon.d.ts",
      "import": "./dist/patterns/starPolygon.js",
      "require": "./dist/patterns/starPolygon.cjs"
    },
    "./patterns/flower-of-life": {
      "types": "./dist/patterns/flowerOfLife.d.ts",
      "import": "./dist/patterns/flowerOfLife.js",
      "require": "./dist/patterns/flowerOfLife.cjs"
    },
    "./patterns/tiling": {
      "types": "./dist/patterns/tiling.d.ts",
      "import": "./dist/patterns/tiling.js",
      "require": "./dist/patterns/tiling.cjs"
    },
    "./patterns/harmonograph": {
      "types": "./dist/patterns/harmonograph.d.ts",
      "import": "./dist/patterns/harmonograph.js",
      "require": "./dist/patterns/harmonograph.cjs"
    },
    "./patterns/voronoi": {
      "types": "./dist/patterns/voronoi.d.ts",
      "import": "./dist/patterns/voronoi.js",
      "require": "./dist/patterns/voronoi.cjs"
    },
    "./render/svg": {
      "types": "./dist/render/svg.d.ts",
      "import": "./dist/render/svg.js",
      "require": "./dist/render/svg.cjs"
    },
    "./render/canvas": {
      "types": "./dist/render/canvas.d.ts",
      "import": "./dist/render/canvas.js",
      "require": "./dist/render/canvas.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts"
  },
  "devDependencies": {
    "astronomy-engine": "^2.1.19",
    "tsup": "^8.0.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.11",
    "vitest": "^1.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
