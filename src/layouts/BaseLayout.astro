---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImagePath?: string;
  url?: string;
}

const { title, description, ogImagePath = 'home', url } = Astro.props;
const canonicalURL = url || Astro.url.toString();
const ogImageURL = new URL(`/og/${ogImagePath}.png`, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
</head>
<body class="bg-bg text-text font-sans">
  <slot />
  <!--
    GoatCounter analytics. Sign up at https://goatcounter.com (free tier),
    register code "eddubnitsky" (or your choice), then update the data-goatcounter URL.
    Privacy-first: no cookies, no GDPR exposure, ~1 KB JS.
  -->
  <script
    data-goatcounter="https://eddubnitsky.goatcounter.com/count"
    async src="//gc.zgo.at/count.js"
  ></script>
</body>
</html>
