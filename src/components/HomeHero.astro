---
import { home } from '../i18n/home';
import type { Lang } from '../i18n/ui';
import EdMonogram from './EdMonogram.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].hero;
---

<section class="max-w-content mx-auto px-6 pt-12 md:pt-20 pb-12">
  <div class="flex flex-col-reverse md:flex-row md:items-center md:gap-12 lg:gap-16">
    <div class="flex-1 mt-8 md:mt-0">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">{c.name}</h1>
      <p class="text-text-muted mt-2 font-mono text-sm">{c.roleLine}</p>
      <p class="text-text mt-6 max-w-2xl leading-relaxed">{c.lead}</p>
      <p class="text-text-muted mt-3 max-w-2xl leading-relaxed">{c.sub}</p>
      <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        <a href="#projects" class="text-accent hover:underline whitespace-nowrap">{c.nav.projects}</a>
        <a href="#about" class="text-accent hover:underline whitespace-nowrap">{c.nav.about}</a>
        <a href="#contact" class="text-accent hover:underline whitespace-nowrap">{c.nav.contact}</a>
      </nav>
    </div>

    <div class="shrink-0 self-start md:self-center">
      <EdMonogram size={320} class="w-[240px] h-[240px] md:w-[320px] md:h-[320px] lg:w-[380px] lg:h-[380px]" />
    </div>
  </div>
</section>
