---
import { home } from '../i18n/home';
import type { Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang].hero;
---

<section class="max-w-content mx-auto px-6 pt-16 pb-12">
  <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">{c.name}</h1>
  <p class="text-text-muted mt-2 font-mono text-sm">{c.roleLine}</p>
  <p class="text-text mt-6 max-w-2xl leading-relaxed">{c.lead}</p>
  <p class="text-text-muted mt-3 max-w-2xl leading-relaxed">{c.sub}</p>
  <nav class="mt-8 flex gap-6 font-mono text-sm">
    <a href="#projects" class="text-accent hover:underline">{c.nav.projects}</a>
    <a href="#about" class="text-accent hover:underline">{c.nav.about}</a>
    <a href="#contact" class="text-accent hover:underline">{c.nav.contact}</a>
  </nav>
</section>
