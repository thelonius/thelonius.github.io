---
// src/components/ssd/RadarSimulation.astro
// a stylized "Radar" view showing vessels as dots with an animated sweep.
---

<div class="relative w-full aspect-square max-w-md mx-auto bg-bg border border-border rounded-full overflow-hidden shadow-inner" style="background: radial-gradient(circle, #1a202c 0%, #0a0c10 100%);">
  
  <!-- Radar Grid -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="absolute w-full h-px bg-border/30"></div>
    <div class="absolute h-full w-px bg-border/30"></div>
    <div class="absolute w-1/2 h-1/2 border border-border/20 rounded-full"></div>
    <div class="absolute w-1/4 h-1/4 border border-border/20 rounded-full"></div>
    <div class="absolute w-1/8 h-1/8 border border-border/20 rounded-full"></div>
  </div>

  <!-- The Sweep Line -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="radar-sweep absolute top-1/2 left-1/2 w-1/2 h-px bg-gradient-to-r from-accent to-transparent origin-left"></div>
  </div>

  <!-- Vessels -->
  <div class="absolute inset-0">
    <!-- Vessel 1: ЛОВЕЦ -->
    <div class="vessel absolute top-1/3 left-1/4 w-2 h-2 bg-accent rounded-full shadow-[0_0_8px_#7dd3fc]" title="ЛОВЕЦ">
        <span class="absolute top-3 left-2 text-[10px] text-accent whitespace-nowrap font-mono">ЛОВЕЦ</span>
    </div>
    <!-- Vessel 2 -->
    <div class="vessel absolute top-2/3 left-2/3 w-2 h-2 bg-text-muted rounded-full opacity-50" title="Vessel-X">
        <span class="absolute top-3 left-2 text-[10px] text-text-muted whitespace-nowrap font-mono">Vessel-X</span>
    </div>
    <!-- Vessel 3 -->
    <div class="vessel absolute top-1/4 left-3/4 w-2 h-2 bg-text-muted rounded-full opacity-50" title="Vessel-Y">
        <span class="absolute top-3 left-2 text-[10px] text-text-muted whitespace-nowrap font-mono">Vessel-Y</span>
    </div>
  </div>

  <!-- Center Point -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-accent rounded-full animate-ping"></div>
</div>

<style>
  .radar-sweep {
    animation: sweep 4s linear infinite;
  }

  @keyframes sweep {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .vessel {
    transition: opacity 0.3s ease;
  }
</style>
