---
// src/components/ssd/GeoInsight.astro
// simulated map view with "catch density" heatmap.
---

<div class="relative w-full aspect-video bg-surface border border-border rounded-lg overflow-hidden group">
  <!-- Background Map (Stylized SVG) -->
  <svg viewBox="0 0 800 400" class="w-full h-full fill-bg stroke-border opacity-40">
    <path d="M100,100 Q200,50 300,100 T500,100 T700,150" stroke-width="2" fill="none" />
    <path d="M50,300 Q200,250 300,300 T500,300 T700,350" stroke-width="2" fill="none" />
    <rect x="150" y="150" width="100" height="100" rx="10" stroke-dasharray="4" />
    <text x="160" y="140" fill="currentColor" font-size="12" class="fill-text-muted">Zone Z</text>
  </svg>

  <!-- Heatmap Blobs -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/3 w-32 h-32 bg-accent/30 blur-3xl rounded-full animate-pulse"></div>
    <div class="absolute top-1/2 left-1/2 w-48 h-48 bg-accent/20 blur-3xl rounded-full animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/4 left-2/3 w-24 h-24 bg-warn/20 blur-3xl rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <!-- Data Overlay -->
  <div class="absolute top-4 left-4 bg-bg/80 backdrop-blur p-3 border border-border rounded text-xs font-mono">
    <div class="text-accent font-bold mb-1">Catch Heatmap</div>
    <div class="flex items-center gap-2">
        <div class="w-3 h-3 bg-accent/50 rounded-full"></div>
        <span>High Density (Минтай)</span>
    </div>
    <div class="flex items-center gap-2 mt-1">
        <div class="w-3 h-3 bg-warn/50 rounded-full"></div>
        <span>Low Density (Треска)</span>
    </div>
  </div>

  <!-- Tooltip Simulation -->
  <div class="absolute top-1/3 left-1/3 translate-x-4 -translate-y-4 bg-bg border border-accent p-2 rounded shadow-xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
    <div class="text-[10px] text-text-muted uppercase font-bold">Insight</div>
    <div class="text-xs text-text">Peak activity detected in Zone Z</div>
    <div class="text-[10px] text-accent font-mono mt-1">42.5t / day</div>
  </div>
</div>
