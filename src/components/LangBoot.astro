---
/**
 * Inline pre-paint language bootstrap.
 *
 * Runs synchronously in <head> before first paint. On the first visit
 * (no stored preference), probes `navigator.languages` and redirects
 * EN → RU if the user's primary preference among {ru, en} is `ru`.
 *
 * Asymmetric on purpose: a shared `/ru/...` link must not yank an
 * English-preference visitor back to `/`. They can switch manually,
 * which writes `localStorage.lang` and silences future auto-detection.
 *
 * Also attaches a click delegate on `document` that records explicit
 * language choices made through LangSwitcher (`<a data-lang-link>`).
 */
---
<script is:inline>
  (function () {
    var STORE_KEY = 'lang';

    function readStored() {
      try {
        var v = localStorage.getItem(STORE_KEY);
        return v === 'ru' || v === 'en' ? v : null;
      } catch (e) {
        return null;
      }
    }

    function writeStored(v) {
      try { localStorage.setItem(STORE_KEY, v); } catch (e) {}
    }

    function detectFromNavigator() {
      var langs = (navigator.languages && navigator.languages.length)
        ? navigator.languages
        : [navigator.language || ''];
      for (var i = 0; i < langs.length; i++) {
        var tag = String(langs[i] || '').toLowerCase();
        if (tag === 'ru' || tag.indexOf('ru-') === 0) return 'ru';
        if (tag === 'en' || tag.indexOf('en-') === 0) return 'en';
      }
      return null;
    }

    var path = location.pathname;
    var onRu = /^\/ru(\/|$)/.test(path);

    // Capture explicit choices via LangSwitcher before navigation fires.
    document.addEventListener('click', function (ev) {
      var t = ev.target;
      while (t && t.nodeType === 1 && !(t.tagName === 'A' && t.hasAttribute('data-lang-link'))) {
        t = t.parentNode;
      }
      if (t && t.nodeType === 1) {
        var v = t.getAttribute('data-lang-link');
        if (v === 'ru' || v === 'en') writeStored(v);
      }
    }, true);

    if (readStored()) return;

    var pref = detectFromNavigator();
    if (pref === 'ru' && !onRu) {
      var target = path === '/' ? '/ru/' : '/ru' + path;
      location.replace(target + location.search + location.hash);
    }
  })();
</script>
