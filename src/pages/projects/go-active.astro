---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusTag from '../../components/StatusTag.astro';
import StackList from '../../components/StackList.astro';
import LinksList from '../../components/LinksList.astro';
import BeforeAfterSplit from '../../components/BeforeAfterSplit.astro';
import PipelineStage from '../../components/PipelineStage.astro';
import MetricsDashboard from '../../components/MetricsDashboard.astro';
import BuiltBy from '../../components/BuiltBy.astro';
import rendersJson from '../../data/go-active-renders.json';

const project = await getEntry('projects', 'go-active');
if (!project) throw new Error('go-active project not found in content collection');
const { data } = project;

interface RenderTile {
  slug: string;
  label: string;
  duration: string;
  src: string;
  poster: string;
  ready: boolean;
}
const renders = rendersJson as RenderTile[];
const readyRenders = renders.filter(r => r.ready);
const queuedRenders = renders.filter(r => !r.ready);
---

<BaseLayout
  title={`${data.title} — Ed Dubnitsky`}
  description={data.description}
  ogImagePath={data.slug}
>
  <header class="sticky top-0 z-10 bg-bg/90 backdrop-blur border-b border-border">
    <div class="max-w-5xl mx-auto px-6 py-3 flex items-baseline justify-between">
      <a href="/" class="text-text-muted hover:text-accent text-sm">← back · {data.title}</a>
      <StatusTag status={data.status} year={data.year} />
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 pt-8 pb-16">
    <figure class="my-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="relative bg-surface border border-border rounded-lg overflow-hidden" style="height: 460px">
          <iframe src="/assets/go-active/trajectory_2d.html" title="Raw GPX top-down" loading="lazy" class="w-full h-full border-0"></iframe>
          <div class="absolute top-3 left-3 px-2 py-1 bg-bg/85 border border-border rounded font-mono text-xs text-text-muted uppercase tracking-wider">
            Raw GPX · 3025 dots
          </div>
        </div>
        <div class="relative bg-surface border border-border rounded-lg overflow-hidden flex items-center justify-center" style="height: 460px">
          <video
            src="/assets/go-active/production_render.mp4"
            poster="/assets/go-active/production_render_poster.png"
            autoplay muted loop playsinline
            class="h-full w-auto"
            aria-label="Real production render from @Vixwibot"
          ></video>
          <div class="absolute top-3 left-3 px-2 py-1 bg-bg/85 border border-border rounded font-mono text-xs text-accent uppercase tracking-wider">
            Real production render
          </div>
          <div class="absolute bottom-3 left-3 px-2 py-1 bg-bg/80 border border-border rounded font-mono text-xs text-text-muted">
            from @Vixwibot · 25 s clip
          </div>
        </div>
      </div>
      <figcaption class="text-text-muted text-sm mt-3 italic">
        Left: how a GPX file looks as raw 2D dots. Right: the same kind of trajectory after the full pipeline runs and the renderer encodes it to MP4 — this clip came straight out of the production bot @Vixwibot. The rest of this page shows how raw dots become that.
      </figcaption>
    </figure>

    <section class="mt-8">
      <h1 class="text-4xl font-semibold tracking-tight">{data.title}</h1>
      <p class="text-text-muted mt-2 text-lg">{data.tagline}</p>
      <p class="text-text-muted text-sm mt-1 font-mono">{data.period}</p>
      <p class="text-accent font-mono text-sm mt-3">
        Live in production at <a href="https://t.me/Vixwibot" class="hover:underline">@Vixwibot</a> · Mini App at <a href="https://vixwi.com/" class="hover:underline">vixwi.com</a>
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-3">Problem</h2>
      <p class="text-text leading-relaxed">
        GPS tracks recorded by mainstream apps (Strava, Komoot) are useful for the user who recorded them but boring to share — flat maps with a coloured line. To turn a workout into something worth watching, the track has to become a cinematic flythrough with terrain context, and the system has to <strong>reject bad tracks</strong> (sparse points, GPS jitter, broken altitude) before spending render budget on them.
      </p>
      <p class="text-text leading-relaxed mt-3">
        The goal: take a GPX file, score it for renderability, and produce a shareable 3D video — all triggered from a Telegram message.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Process</h2>
      <p class="text-text-muted text-sm mb-4">Five async stages, each with explicit memory and time budgets. Below: each stage running on the real <code class="font-mono text-accent text-xs">227-arkhyz-teberda-2024.gpx</code>.</p>

      <PipelineStage
        num={1}
        name="Parse GPX"
        what="Read the file, validate timestamps and altitudes, extract one Point per sample. Pass downstream as a typed list — no XML touched again."
        inputLabel="GPX file blob"
        inputValue={'name: 227-arkhyz-teberda-2024\nsize: ~280 KB\nformat: GPX 1.1'}
        outputLabel="3025 Point objects"
        outputValue={'first: { lat: 43.5604, lon: 41.2851,\n         ele: 1457.1, time: 2025-11-10T09:34:02Z }\nlast:  { lat: 43.5375, lon: 41.3377,\n         ele: 2354.3, time: 2025-11-12T07:44:11Z }'}
        observation="3025 samples across 46 hours of moving time."
      />

      <PipelineStage
        num={2}
        name="Terrain query"
        what="Build a bounding box from the trajectory, fetch terrain tiles, attach surface elevation to each Point. Lets us check for impossible-altitude jumps later."
        inputLabel="bbox"
        inputValue={'lat: 43.51 → 43.62\nlon: 41.28 → 41.37\nspan: ~12 km × 7 km'}
        outputLabel="Elevation profile"
        outputIframe="/assets/go-active/elevation_profile.html"
        observation="Real climb: 1242 m → 2883 m, +8028 m cumulative. The profile shows the multi-day trek shape."
      />

      <PipelineStage
        num={3}
        name="Smoothing & interpolation"
        what="Median-filter the GPS jitter, spline-fit the path so the renderer doesn't draw a noisy zigzag. Gradient computed from smoothed altitudes."
        inputLabel="raw jitter"
        inputValue={'time-gap mean:    54.96 s\ntime-gap jitter:   83.4 %\naltitude stddev:  12.54 m'}
        outputLabel="speed profile (post-smoothing)"
        outputIframe="/assets/go-active/speed_profile.html"
        observation="Gaps of 55 s ± 83 % mean the device slept and woke unevenly. Smoother speed curve confirms filtering held."
      />

      <PipelineStage
        num={4}
        name="CV quality scoring"
        what="A small ensemble of scorers reads the cleaned track and produces four sub-scores plus an overall. Bad tracks get rejected here before the expensive render runs."
        inputLabel="cleaned track + signals"
        inputValue={'point density · time-gap jitter\ndropout %       · altitude jitter'}
        outputLabel="scores 0-100 + 8 raw metrics"
        outputValue={'overall:  32.4\ndensity:  37.8   jitter:    16.6\ndropout:  37.8   altitude:  37.3'}
        observation="This trek scored low — uneven GPS sampling. Production would reject; for a showcase it is a useful negative example. See the full dashboard below."
      />

      <PipelineStage
        num={5}
        name="Render"
        what="Build the 3D scene from the smoothed track + terrain, encode to MP4 via FFmpeg, return to Telegram. Skipped automatically when stage 4 rejects the track. The 25-second clip in the hero of this page is a real artefact of this stage from @Vixwibot."
        inputLabel="scored track"
        inputValue={'kept: { quality > 50 → render }\nrejected: { return diagnostic }'}
        outputLabel="3D trajectory artefact"
        outputIframe="/assets/go-active/trajectory_3d.html"
        observation="Plotly 3D embed here is interactive — drag to rotate. The MP4 in the hero is what end-users actually receive in Telegram."
      />
    </section>

    <section class="mt-16 pt-8 border-t border-border">
      <div class="flex items-baseline justify-between flex-wrap gap-2 mb-3">
        <h2 class="text-2xl font-semibold text-accent">ARA — Analyze Route Animation</h2>
        <span class="font-mono text-xs uppercase tracking-wider text-text-muted">internal CV/ML tool · separate repo</span>
      </div>
      <p class="text-text leading-relaxed">
        ARA is a separate Python project I built alongside Go-Active to <strong>validate and tune the renderer</strong> without staring at hundreds of hours of MP4. It is not stitched into the production pipeline — it is the lab bench. Two engines, one CLI: a <strong>pre-render optimizer</strong> that searches for the best camera path before the render starts, and a <strong>post-render analyzer</strong> that scores the resulting video on seven metric groups using PyTorch + OpenCV.
      </p>
      <p class="text-text-muted text-sm mt-2">
        Everything below is computed live by ARA on the real <code class="font-mono text-accent text-xs">render_forest.mp4</code> shown earlier on this page — 601 frames, 25 s, 24 fps. The numbers are read from the JSON reports the CLI just produced.
      </p>

      <h3 class="text-lg font-semibold text-text mt-8 mb-2">Two-engine architecture</h3>
      <p class="text-text-muted text-sm mb-4">
        Same codebase, two entry points. The optimizer takes a 3D scene and proposes a camera animation; the analyzer takes the resulting MP4 and scores how close to the proposal it landed.
      </p>
      <pre class="mermaid">graph LR
  subgraph pre["Pre-render Optimizer"]
    terrain[("terrain.json<br/>heightmap")]
    route[("route.json<br/>waypoints")]
    scorer["viewpoint_scorer<br/>32 candidates × 16 angles"]
    smoother["path_smoother<br/>Catmull-Rom + damping"]
    optimizer["optimizer<br/>3 search iterations"]
    anim[("camera_animation.json")]
    terrain --> scorer
    route --> scorer
    scorer --> optimizer
    optimizer --> smoother
    smoother --> anim
  end
  subgraph post["Post-render Analyzer"]
    mp4[("rendered MP4")]
    va["video_analyzer<br/>7 metric groups"]
    cma["camera_motion_analyzer<br/>segment classifier"]
    cr["camera_reconstructor<br/>SfM · SIFT/ORB/AKAZE"]
    rep[("analysis_report.json")]
    mp4 --> va
    mp4 --> cma
    mp4 --> cr
    va --> rep
    cma --> rep
    cr --> rep
  end</pre>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Seven metric groups</h3>
      <p class="text-text-muted text-sm mb-4">
        Each group is a small bag of measurements computed per frame and aggregated. Live values shown are from <code class="font-mono text-accent text-xs">forest_report.json</code>.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">terrain view</span>
            <span class="font-mono text-xs text-text-muted">5 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Is the camera looking at the ground at a useful angle? Surface-normal alignment via depth gradient, tangent-view penalty, near-range occlusion check.</p>
          <pre class="font-mono text-xs text-text">surface_normal_alignment  0.65
favorable_angle_ratio     0.70
terrain_coverage_ratio    1.00
near_range_occlusion      0.15</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">scene depth</span>
            <span class="font-mono text-xs text-text-muted">3 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">How layered is the shot? K-means on the depth histogram for layer count, entropy of depth distribution, foreground/background separation.</p>
          <pre class="font-mono text-xs text-text">layer_count                3
depth_distribution_entropy 0.60
foreground_background_sep  0.70</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">composition</span>
            <span class="font-mono text-xs text-text-muted">4 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Frame economics — how much pixel area carries information vs sky vs empty terrain, where the runner sits in the rule-of-thirds grid.</p>
          <pre class="font-mono text-xs text-text">informative_fill_ratio    0.85
traveler_visibility       0.90
traveler_framing_score    0.75
sky_terrain_balance       0.30</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">temporal</span>
            <span class="font-mono text-xs text-text-muted">4 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Pacing across the clip. New visual information per second (information_flow), narrative reveal timing, frame-to-frame coherence.</p>
          <pre class="font-mono text-xs text-text">information_flow          0.55
revelation_timing         0.60
visual_variety            0.06
coherence                 0.80</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">camera motion</span>
            <span class="font-mono text-xs text-text-muted">6 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Optical-flow velocity vectors per frame → jitter, dropped/stuttered frames, smoothness, stability. Computed by <code class="text-accent">camera_motion_analyzer</code>.</p>
          <pre class="font-mono text-xs text-text">smoothness_score          0.59
jitter_level_px          10.92
stability_index           0.85
dropped / stutter         1 / 1</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">animation</span>
            <span class="font-mono text-xs text-text-muted">4 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Whole-clip behaviour: duration, mean px/sec, how steady that speed is across the timeline, estimated camera-height score.</p>
          <pre class="font-mono text-xs text-text">duration_seconds          25.04
average_speed_px_per_sec 384.39
speed_consistency         0.80
camera_height_score       0.94</pre>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4 md:col-span-2">
          <div class="flex items-baseline justify-between mb-1">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">tiles quality</span>
            <span class="font-mono text-xs text-text-muted">4 metrics</span>
          </div>
          <p class="text-text-muted text-xs mb-3">Were the satellite tiles fetched cleanly? Sharpness via Laplacian variance, JPEG-blockiness detector, mid-frequency texture, fraction of frames showing loading artefacts. Catches CDN problems that don't show up in any other group.</p>
          <pre class="font-mono text-xs text-text">sharpness_score        1.00      texture_detail_score   0.47
blockiness_score       1.00      loading_artifacts      0.00</pre>
        </div>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Live metric bars · two real renders</h3>
      <p class="text-text-muted text-sm mb-3">
        Same eleven metrics computed for both clips. The 8-second short scores higher on smoothness and texture detail; the 25-second forest pulls ahead on framing because the camera has more time to settle.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 360px">
        <iframe src="/assets/go-active/ara/ara_metric_bars.html" class="w-full h-full border-0" loading="lazy" title="ARA metric bars"></iframe>
      </div>
      <p class="mt-3 text-sm text-text-muted italic border-l-2 border-accent pl-3">
        <span class="font-mono uppercase text-xs not-italic mr-2">Observed:</span>
        Overall quality <strong class="text-accent">69.18 %</strong> for the forest clip vs <strong class="text-accent">70.27 %</strong> for the short. The big gap is in <code class="font-mono text-accent text-xs">texture_detail_score</code> — 0.79 vs 0.47 — because the longer clip spends more frames on dark forest where mid-band detail collapses. That is exactly the kind of finding ARA exists to surface.
      </p>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Camera motion timeline · 188 segments</h3>
      <p class="text-text-muted text-sm mb-3">
        <code class="font-mono text-accent text-xs">camera_motion_analyzer</code> classified every frame into one of eight motion modes by clustering optical-flow vectors over a sliding window, then merged neighbours into segments. The timeline below is the result on the 25-second forest render — every coloured slice is one segment, hover to see the type, speed and quality.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 260px">
        <iframe src="/assets/go-active/ara/ara_motion_timeline.html" class="w-full h-full border-0" loading="lazy" title="ARA motion timeline"></iframe>
      </div>
      <p class="mt-3 text-sm text-text-muted italic border-l-2 border-accent pl-3">
        <span class="font-mono uppercase text-xs not-italic mr-2">Observed:</span>
        188 segments total — <strong class="text-accent">86 rotate</strong>, <strong class="text-accent">33 static</strong>, 32 tilt-down, 25 pan-left, 6 pan-right, 6 tilt-up. The renderer favours rotation around the runner with periodic static beats; the absence of <code class="font-mono text-accent text-xs">zoom_in / zoom_out</code> tells me the camera holds focal length, which simplifies the SfM reconstruction below.
      </p>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Per-segment velocity · coloured by motion quality</h3>
      <p class="text-text-muted text-sm mb-3">
        Speed in px/frame for every segment, dot colour = the segment's quality score. Dips towards zero are the static beats; the spikes are short rotation pivots. The variance is what feeds <code class="font-mono text-accent text-xs">jerk_index = 3194</code> in the motion report.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 280px">
        <iframe src="/assets/go-active/ara/ara_velocity_curve.html" class="w-full h-full border-0" loading="lazy" title="ARA velocity curve"></iframe>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Pre-render optimizer · weights and search</h3>
      <p class="text-text-muted text-sm mb-3">
        Before a render starts, ARA can sample the camera search space and pick the best path. Six objectives are mixed by weight; the search is small enough to run per-route on CPU.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="bg-surface border border-border rounded-lg p-4">
          <p class="font-mono text-xs uppercase tracking-wider text-accent mb-2">objective weights</p>
          <pre class="font-mono text-xs text-text">terrain_visibility   0.25
scene_depth          0.20
composition          0.20
traveler_framing     0.15
smoothness           0.15
information_flow     0.05</pre>
          <p class="text-text-muted text-xs mt-2 italic">From <code class="text-accent">core/config.py</code>. The five-way split between visibility / depth / composition / framing keeps any single head from dominating; smoothness is half-weighted because the path smoother handles it deterministically afterwards.</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <p class="font-mono text-xs uppercase tracking-wider text-accent mb-2">search settings</p>
          <pre class="font-mono text-xs text-text">candidate_positions     32
angular_samples         16
optimization_iterations  3
camera_height        5–100 m
camera_distance     10–150 m
fov                  45°–90°</pre>
          <p class="text-text-muted text-xs mt-2 italic">32 × 16 × 3 = 1536 viewpoint evaluations per anchor frame. Cheap enough to run on every keyframe before committing to the render budget.</p>
        </div>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">CLI surface</h3>
      <p class="text-text-muted text-sm mb-3">
        Six commands. The whole tool is a Typer app with rich tables for terminal output and Pydantic models for everything that goes to JSON.
      </p>
      <div class="bg-surface border border-border rounded-lg p-4 overflow-x-auto">
        <pre class="font-mono text-xs text-text leading-relaxed whitespace-pre">$ ara info               # show version, available metrics
$ ara create-sample      # generate a heightmap + circular route
$ ara optimize \           # pre-render: search for best camera path
    --terrain  terrain.json \
    --route    route.json \
    --output   camera_animation.json --fps 30
$ ara analyze video.mp4  --output report.json   # 7-group quality scoring
$ ara motion  video.mp4  --output motion.json   # segment classifier
$ ara reconstruct video.mp4  --detector SIFT \
    --output trajectory.json --blender scene.py # SfM → Blender script</pre>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">What the analyzer's PyTorch heads see</h3>
      <p class="text-text-muted text-sm mb-4">
        Inside <code class="font-mono text-accent text-xs">video_analyzer.py</code>, every frame is read through OpenCV and pushed through three small heads — depth (DPT-Hybrid via Hugging Face <code class="font-mono text-accent text-xs">transformers</code>, on Apple MPS), HSV-mask blob detection for the runner marker, Sobel-edge density for the texture/stability metrics. A composite tensor goes into the per-frame scorer that aggregates into the seven groups above. Below: those same heads running on a single frame from the forest clip — full-resolution intermediates from a debug session.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <figure class="bg-surface border border-border rounded-lg overflow-hidden">
          <div class="bg-bg p-3 flex items-baseline justify-between border-b border-border">
            <span class="font-mono text-xs uppercase tracking-wider text-text-muted">input frame</span>
            <span class="font-mono text-xs text-text-muted">464×536 · @Vixwibot render</span>
          </div>
          <img src="/assets/go-active/cv/cv_original.png" alt="Original render frame" class="w-full" loading="lazy" />
        </figure>

        <figure class="bg-surface border border-border rounded-lg overflow-hidden">
          <div class="bg-bg p-3 flex items-baseline justify-between border-b border-border">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">depth · DPT-Hybrid</span>
            <span class="font-mono text-xs text-text-muted">monocular depth from RGB</span>
          </div>
          <img src="/assets/go-active/cv/cv_depth.png" alt="DPT depth estimation" class="w-full" loading="lazy" />
          <figcaption class="text-text-muted text-xs px-3 py-2 italic">Reds are near, blues are far. The hill ridge stands out — feeds <code class="text-accent">scene_depth</code> layer count and FG/BG separation.</figcaption>
        </figure>

        <figure class="bg-surface border border-border rounded-lg overflow-hidden">
          <div class="bg-bg p-3 flex items-baseline justify-between border-b border-border">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">marker · HSV blob</span>
            <span class="font-mono text-xs text-text-muted">located at (273, 162) ± 5 px</span>
          </div>
          <img src="/assets/go-active/cv/cv_marker.png" alt="Red marker detection" class="w-full" loading="lazy" />
          <figcaption class="text-text-muted text-xs px-3 py-2 italic">Red runner dot via HSV mask + largest-blob centroid. Used by <code class="text-accent">traveler_visibility</code> and <code class="text-accent">traveler_framing_score</code> to compute rule-of-thirds offset.</figcaption>
        </figure>

        <figure class="bg-surface border border-border rounded-lg overflow-hidden">
          <div class="bg-bg p-3 flex items-baseline justify-between border-b border-border">
            <span class="font-mono text-xs uppercase tracking-wider text-accent">edges · Sobel</span>
            <span class="font-mono text-xs text-text-muted">texture and stability</span>
          </div>
          <img src="/assets/go-active/cv/cv_edges.png" alt="Sobel edges" class="w-full" loading="lazy" />
          <figcaption class="text-text-muted text-xs px-3 py-2 italic">Edge density feeds <code class="text-accent">texture_detail_score</code> and the stability index — too low = blurry tile fetch, too high = busy scene.</figcaption>
        </figure>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">ARA stack</h3>
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm">
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">torch + torchvision</span><br/><span class="text-text-muted text-xs">depth, tensor ops</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">timm</span><br/><span class="text-text-muted text-xs">DPT backbone</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">opencv-python</span><br/><span class="text-text-muted text-xs">video I/O, optical flow, SIFT/ORB/AKAZE</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">scipy</span><br/><span class="text-text-muted text-xs">Catmull-Rom smoothing, signal stats</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">pydantic + pydantic-settings</span><br/><span class="text-text-muted text-xs">typed config, JSON in/out</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">typer + rich</span><br/><span class="text-text-muted text-xs">CLI, terminal tables</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">plotly</span><br/><span class="text-text-muted text-xs">timeline + velocity charts on this page</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">pyyaml</span><br/><span class="text-text-muted text-xs">override defaults via config files</span></li>
        <li class="bg-surface border border-border rounded p-2"><span class="font-mono text-accent text-xs">~2 100 LoC</span><br/><span class="text-text-muted text-xs">six modules, separate from Go-Active</span></li>
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Quality dashboard</h2>
      <p class="text-text-muted text-sm mb-4">
        Same scores, packaged for Telegram. Each gauge is one CV head; the tiles are raw measurements feeding them.
      </p>
      <MetricsDashboard
        src="/assets/go-active/quality_dashboard.svg"
        alt="Go-Active quality dashboard with gauges and metric tiles"
        caption="Computed live from the Архыз GPX. Lower scores reveal real issues — this trek's GPS sampling was uneven (83 % time-gap variance). Production rejects tracks under ~50 to save render budget."
      />
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Smart rendering</h2>
      <p class="text-text-muted text-sm mb-4">
        The render stage isn't a dumb camera flying at constant speed along the track.
        Three algorithms shape what the viewer ends up seeing — all running on this same Архыз GPX.
      </p>

      <h3 class="text-lg font-semibold text-text mt-8 mb-2">Real production renders</h3>
      <p class="text-text-muted text-sm mb-3">
        Actual MP4s straight from @Vixwibot. The renderer adapts framing and pacing to the terrain — short suburban loops play one way, mountain treks another. All 720×1280 vertical for Telegram. The mountain and Crimean tiles below get filled in as the bot's queue drains — these renders take 1-3 hours each.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {readyRenders.map(r => (
          <div class="relative bg-surface border border-border rounded-lg overflow-hidden flex items-center justify-center" style="height: 360px">
            <video src={r.src} poster={r.poster} autoplay muted loop playsinline class="h-full w-auto" aria-label={r.label}></video>
            <div class="absolute top-3 left-3 px-2 py-1 bg-bg/85 border border-border rounded font-mono text-xs text-text-muted">{r.label}</div>
          </div>
        ))}
        {queuedRenders.map(r => (
          <div class="relative bg-bg border border-dashed border-border rounded-lg overflow-hidden flex flex-col items-center justify-center text-center px-4" style="height: 360px">
            <div class="font-mono text-3xl text-accent mb-2">▴</div>
            <div class="font-mono text-xs text-text-muted uppercase tracking-wider mb-2">queued render</div>
            <div class="text-text text-sm leading-snug">{r.label}</div>
            <div class="text-text-muted text-xs mt-2">rendering at @Vixwibot — auto-replaces when ready</div>
          </div>
        ))}
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Animated flythrough (interactive)</h3>
      <p class="text-text-muted text-sm mb-3">
        Auto-rotating 3D scene of the same Архыз track in Plotly form — drag to rotate manually. The yellow diamond marks the camera's current position. The production renderer above encodes a longer version of this onto satellite imagery with FFmpeg.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 480px">
        <iframe src="/assets/go-active/flythrough_animated.html" class="w-full h-full border-0" loading="lazy" title="Animated flythrough"></iframe>
      </div>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Loop detection</h3>
      <p class="text-text-muted text-sm mb-3">
        A loop closure is two points on the track that are spatially close but separated by significant path distance — usually a route that returns to a previous spot. The renderer uses these to plan a "highlight reel" cut: a tight orbit at each closure instead of replaying the whole loop.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 420px">
        <iframe src="/assets/go-active/loops_detected.html" class="w-full h-full border-0" loading="lazy" title="Loop detection"></iframe>
      </div>
      <p class="mt-4 text-sm text-text-muted italic border-l-2 border-accent pl-3">
        <span class="font-mono uppercase text-xs not-italic mr-2">Observed:</span>
        On this trek the algorithm flagged <strong class="text-accent">3 closures</strong>: a 120m approach back to the camp area at point 168 ↔ 2736, a tight 24m return at 486 ↔ 2862, and the final 64m closing of the whole route at 204 ↔ 3024.
      </p>

      <h3 class="text-lg font-semibold text-text mt-10 mb-2">Camera behaviour heuristic</h3>
      <p class="text-text-muted text-sm mb-3">
        A boring constant-speed flythrough wastes attention. The heuristic scores each segment for "interestingness" — derived from elevation gradient + heading-change rate over a sliding window — then plans a virtual-camera speed multiplier from that. Slow at peaks and turns, fast across monotonous sections, total render duration preserved.
      </p>
      <div class="bg-surface border border-border rounded-lg overflow-hidden" style="height: 380px">
        <iframe src="/assets/go-active/camera_speed_curve.html" class="w-full h-full border-0" loading="lazy" title="Camera speed plan"></iframe>
      </div>
      <p class="mt-4 text-sm text-text-muted italic border-l-2 border-accent pl-3">
        <span class="font-mono uppercase text-xs not-italic mr-2">Observed:</span>
        Speed plan ranges <strong class="text-accent">0.47×</strong> (deepest slow-down on the highest peaks) to <strong class="text-accent">1.6×</strong> (cruise across rolling sections). 60 named events — the diamonds in the chart — flagged as worth dwelling on.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Architecture</h2>
      <p class="text-text-muted text-sm mb-4">
        Five-stage async FastAPI pipeline behind a Telegram Mini App.
      </p>
      <pre class="mermaid">graph LR
  user[Telegram user] -->|GPX upload| bot[Telegram Bot API]
  bot --> api[FastAPI]
  api --> s1[1. Parse]
  s1 --> s2[2. Terrain]
  s2 --> s3[3. Smooth]
  s3 --> s4[4. CV scoring]
  s4 -->|reject| diag[Return diagnostic]
  s4 -->|keep| s5[5. Render]
  s5 -->|MP4 + grade| bot
  bot --> user</pre>
      <p class="text-text-muted text-sm mt-3">
        Each stage has its own timeout and memory budget. Rejection at stage 4 saves the render budget for tracks worth watching.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Stack</h2>
      <StackList stack={data.stack} />
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-accent mb-2">Links</h2>
      <p class="text-text-muted text-sm mb-3">
        Live in production at <strong>@Vixwibot</strong> in Telegram — search for it in your client, or open the Mini App directly at <a href="https://vixwi.com/" class="text-accent hover:underline">vixwi.com</a>. Upload your own GPX to see your render.
      </p>
      <ul class="flex flex-col gap-2">
        <li>
          <a href="https://t.me/Vixwibot" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-accent hover:underline">
            <span class="font-mono text-text-muted">↗</span>
            Open @Vixwibot in Telegram
          </a>
        </li>
        <li>
          <a href="https://vixwi.com/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-accent hover:underline">
            <span class="font-mono text-text-muted">↗</span>
            vixwi.com — Mini App entry
          </a>
        </li>
      </ul>
    </section>

    <BuiltBy
      author="Ed Dubnitsky"
      scope="end-to-end: pipeline architecture, CV scoring, Telegram Mini App, deployment"
      aiAugmented="Claude Code"
      status="Solo project · in production with real users"
    />
  </main>
</BaseLayout>
