---
import { render } from 'astro:content';
import ShowcaseLayout from '../../../layouts/ShowcaseLayout.astro';
import { getProjects } from '../../../i18n/utils';

export async function getStaticPaths() {
  const projects = await getProjects('ru');
  return projects
    .filter((p) => p.data.deep)
    .filter((p) => p.data.slug !== 'go-active') // custom page at /ru/projects/go-active.astro
    .filter((p) => p.data.slug !== 'proptech') // custom page at /ru/projects/proptech.astro
    .map((project) => ({
      params: { slug: project.data.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ShowcaseLayout project={project} lang="ru">
  <Content />
</ShowcaseLayout>
