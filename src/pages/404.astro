---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Ed Dubnitsky" description="Page not found.">
  <main class="max-w-content mx-auto px-6 py-32 text-center">
    <p class="font-mono text-6xl text-accent">404</p>
    <p class="text-text mt-4">No page at this URL.</p>
    <p class="text-text-muted mt-1">По этому адресу ничего нет.</p>
    <a href="/" class="font-mono text-sm text-accent hover:underline mt-8 inline-block">← back to home</a>
  </main>
</BaseLayout>
